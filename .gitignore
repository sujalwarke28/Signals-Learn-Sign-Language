# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signals: local config and generated Firebase files.
# The Firebase/Cloudinary values in these are project identifiers rather than
# secrets, but keeping them out of the repo means a clone doesn't inherit
# someone else's backend. Recreate them with the steps in docs/.
lib/core/config/app_config.dart
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
# .firebaserc names your specific project; firebase.json is generic config and
# is committed so hosting/rules settings travel with the repo.
.firebaserc
.firebase/

# Build outputs kept for handing around
release/
